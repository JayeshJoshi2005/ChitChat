# Optional overrides when the API/socket server is hosted separately.
# Development uses Vite's proxy to localhost:5001; production uses the current host.
# VITE_API_URL=https://api.example.com/api
# VITE_SOCKET_URL=https://api.example.com

# Optional STUN/TURN configuration for calls across different networks.
# The relay provider supplies the TURN URL and credentials. Vite values are public
# browser configuration; use short-lived credentials for production relays.
# VITE_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:relay.example.com:3478","username":"relay-user","credential":"relay-credential"}]'
